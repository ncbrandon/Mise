# Paste these into Portainer → Stack → Environment variables (or "Load variables from .env file").

# Required
POSTGRES_PASSWORD=change-this-db-password
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

# The address your iPhone uses to reach the server (used for share links and uploaded photos).
# Use your reverse-proxy HTTPS address if you have one, e.g. https://mise.example.com
PUBLIC_URL=http://192.168.1.50:8000
MISE_PORT=8000

# Turn off after creating accounts for your household (the first account is always allowed).
ALLOW_REGISTRATION=true
# cooked.wiki-style reader: http://server:8000/https://any-site.com/recipe
PUBLIC_READER=true

# --- AI (unlocks video, photo, voice, document imports, nutrition, sub-recipe breakdown) ---
# Any OpenAI-compatible API. Examples:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=anthropic/claude-sonnet-4.5
#   Ollama:      LLM_BASE_URL=http://ollama:11434/v1       LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Leave empty to use LLM_MODEL for photos too (it must support images)
LLM_VISION_MODEL=

# Speech-to-text for videos without captions (OpenAI: whisper-1). Leave empty to disable.
TRANSCRIBE_MODEL=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
